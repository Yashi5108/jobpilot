APP_NAME=JobPilot
APP_ENV=development

RESUME_UPLOAD_MAX_BYTES=10485760

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60

DATABASE_URL=sqlite:///./data/jobpilot.db
RESUME_STORAGE_DIR=./data/resumes

BROWSER_ASSISTANT_MODE=playwright
BROWSER_HEADLESS=true
BROWSER_AUTO_SUBMIT_ENABLED=false
BROWSER_RESTRICTED_HOSTS=linkedin.com,naukri.com

SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_API_BASE_URL=

JOBPILOT_API_BASE_URL=http://backend:8000
